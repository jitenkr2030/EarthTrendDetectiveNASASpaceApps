            "text/html": "<div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"seasonal-anomaly-check\">Seasonal Anomaly Check</h2></span><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">An anomaly represents the difference between the\nobserved value and the corresponding monthly seasonal\nbaseline.</span>\n<span class=\"paragraph\"><strong>Positive:</strong> wetter than the baseline.</span>\n<span class=\"paragraph\"><strong>Negative:</strong> drier than the baseline.</span></span><marimo-ui-element object-id='BYtC-0' random-id='fd3aaae8-b854-f6ed-6060-1fbc0c3b8270'><marimo-table data-initial-value='[]' data-label='null' data-data='&quot;[{&#92;&quot;_marimo_row_id&#92;&quot;:0,&#92;&quot;month&#92;&quot;:&#92;&quot;2015-04&#92;&quot;,&#92;&quot;anomaly&#92;&quot;:1.212896088894353e-18},{&#92;&quot;_marimo_row_id&#92;&quot;:1,&#92;&quot;month&#92;&quot;:&#92;&quot;2015-05&#92;&quot;,&#92;&quot;anomaly&#92;&quot;:-4.9785153416244955e-18},{&#92;&quot;_marimo_row_id&#92;&quot;:2,&#92;&quot;month&#92;&quot;:&#92;&quot;2015-06&#92;&quot;,&#92;&quot;anomaly&#92;&quot;:6.332445859460052e-18},{&#92;&quot;_marimo_row_id&#92;&quot;:3,&#92;&quot;month&#92;&quot;:&#92;&quot;2015-07&#92;&quot;,&#92;&quot;anomaly&#92;&quot;:-1.3398270749414364e-17},{&#92;&quot;_marimo_row_id&#92;&quot;:4,&#92;&quot;month&#92;&quot;:&#92;&quot;2015-08&#92;&quot;,&#92;&quot;anomaly&#92;&quot;:1.8278061990780017e-17},{&#92;&quot;_marimo_row_id&#92;&quot;:5,&#92;&quot;month&#92;&quot;:&#92;&quot;2015-09&#92;&quot;,&#92;&quot;anomaly&#92;&quot;:-2.831971333139373e-17},{&#92;&quot;_marimo_row_id&#92;&quot;:6,&#92;&quot;month&#92;&quot;:&#92;&quot;2015-10&#92;&quot;,&#92;&quot;anomaly&#92;&quot;:5.951652901318801e-18},{&#92;&quot;_marimo_row_id&#92;&quot;:7,&#92;&quot;month&#92;&quot;:&#92;&quot;2015-11&#92;&quot;,&#92;